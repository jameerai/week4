  const GalleryScreen({super.key});

  // Step-3: Dummy data items for gallery display
  static const List<GalleryItem> items = [
    GalleryItem(
      title: 'Mountain Retreat',
      description: 'Explore scenic landscapes and peaceful trails.',
      icon: Icons.landscape,
