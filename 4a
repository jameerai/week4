      icon: Icons.ac_unit,
      color: Colors.cyan,
    ),
  ];

  // Helper method to determine device classification category
  String _getDeviceCategory(double width) {
    if (width < 600) return 'Mobile';
    if (width < 1024) return 'Tablet';
    return 'Desktop';
  }

  @override
  Widget build(BuildContext context) {
    // Step-4: Detect total width and orientation using MediaQuery
    final double screenWidth = MediaQuery.of(context).size.width;
    final Orientation mediaOrientation = MediaQuery.of(context).orientation;
    final String category = _getDeviceCategory(screenWidth);
    final String orientationText =
        mediaOrientation == Orientation.portrait ? 'Portrait' : 'Landscape';

    return Scaffold(
      appBar: AppBar(
        title: Text('Gallery App ($category -$orientationText)'),
        backgroundColor: Colors.deepOrange,
        foregroundColor: Colors.white,
      ),
      // Step-4: Use LayoutBuilder to determine constraints and layout strategy
      body: LayoutBuilder(
        builder: (context, constraints) {
          final double maxWidth = constraints.maxWidth;

          if (maxWidth >= 1024) {
            return _buildDesktopLayout(context, maxWidth);
          } else if (maxWidth >= 600) {
            return _buildTabletLayout(context, maxWidth);
          } else {
            return _buildMobileLayout(context, maxWidth);
          }
        },
      ),
      // Step-8: Footer displaying category, screen width, and orientation
      bottomNavigationBar: BottomAppBar(
        color: Colors.grey.shade200,
        elevation: 4,
        child: Container(
          alignment: Alignment.center,
          padding: const EdgeInsets.all(8.0),
          child: Text(
            'Device: $category  |  Orientation: $orientationText  \vert{}  Width:${screenWidth.toStringAsFixed(1)} px',
            textAlign: TextAlign.center,
            style: TextStyle(
              fontSize: 13,
              fontWeight: FontWeight.bold,
              color: Colors.grey.shade900,
            ),
          ),
        ),
      ),
    );
  }

